{
    "compilerOptions": {
        "target": "ESNext",
        "lib": [
            "ESNext",
            "DOM"
        ],
        "module": "ESNext",
        "jsx": "react",
        "outDir": "dist",
        "moduleResolution": "bundler",
        "declaration": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "strict": true,
        "skipLibCheck": true,
        "types": [
            "node"
        ]
    },
    "include": [
        "src",
        "*.config.ts"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ],
}